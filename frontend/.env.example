# Supabase project — used directly from the browser for reads/writes that
# don't need a secret (content assets, schedule, comments, analytics).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Python API (api/) — owns metadata/thumbnail/clip generation and
# publish. In production (single Vercel project) it's same-origin under /api,
# so leave empty or set to /api. For local uvicorn dev, set to http://localhost:8000/api
VITE_API_URL=/api

