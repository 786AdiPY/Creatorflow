# Supabase project — used directly from the browser for reads/writes that
# don't need a secret (content assets, schedule, comments, analytics).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Python API (../backend-api) — owns metadata/thumbnail/clip generation
# and publish, the operations that need a server-side secret.
VITE_API_URL=http://localhost:8000
